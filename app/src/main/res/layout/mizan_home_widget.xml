<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_emerald"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ ميزان المالي الذكي"
            android:textColor="#A7F3D0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_net_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الرصيد: 0 ج.م"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_daily_limit_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="المسموح صرفه اليوم بأمان:"
        android:textColor="#D1FAE5"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_daily_safe_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 ج.م / يومياً"
        android:textColor="#FBBF24"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_wallets_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="كاش: 0 • بنك: 0 • محفظة: 0"
        android:textColor="#E2E8F0"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_quick_add"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:backgroundTint="#10B981"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ معاملة سريعة"
            android:textColor="#042F2E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_whatsapp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#0284C7"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📲 ملخص اليوم"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
